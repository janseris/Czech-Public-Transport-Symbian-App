0be 10 minut.\u0003url 9https://www.cd.cz/jizdni-rad/omezeni-provozu/vyluka/24264P\u0003\u0002id9\u0090\u0001\u0006stopID:\u00cd\u001f\u00e8\u0004text \u00053 / 5P\u0003\u0002id9\u0090\u0001\u0006stopID:\u00c1%\u00e8\u0004text \u00053 / 5P\u0003\u0002id9\u0090\u0001\u0006stopID: #\u00e8\u0004text \u00053 / 3P\u0003\u0002id9\u0090\u0001\u0006stopID:\u0013&\u00e8\u0004text \u00053 / 3P\u0003\u0002id9\u0090\u0001\u0006stopID:\u00b1!\u00e8\u0004text \u0005- / 2P\u0003\u0002id9\u0090\u0001\u0006stopID:W&\u00e8\u0004text \u0005- / 2P\u0003\u0002id9\u0090\u0001\u0006stopID:\u009d\u001e\u00e8\u0004text \u00051 / 3P\u0003\u0002id9\u0090\u0001\u0006stopID:#'\u00e8\u0004text \u00051 / 3P\u0003\u0002id9\u0090\u0001\u0006stopID:\u0003\u001c\u00e8\u0004text \u00053 / 3P\u0003\u0002id9\u0090\u0001\u0006stopID:\u0080)\u00e8\u0004text \u00053 / 3P\u0003\u0002id9\u0090\u0001\u0006stopID;3\u00d9k\u0001\u0004text \u00053 / 2P\u0003\u0002id9\u0090\u0001\u0006stopID:\u0088-\u00e8\u0004text \u00053 / 2\u000boriginIndexX\u0000\u0007originsX\u0000\boznEndID:\u00d6%\u00e8\noznStartID:D\u00fc\u00e7\u000fpartDescription TR13;;15203396;;2026-09-30T17:08:00+02:00;;15214038;;2026-09-30T19:24:00+02:00;;0;;11\rrouteLongName \u0003R13\trouteName \u000bR13 / R 804\u000bstartSCodesX\u0000\u000bstartStopID:0\u001f\u00e8\u0012startStopTripIndex8\u0000\u0005stopsX\fP\n\narrivalISO \u00192026-09-30T17:08:00+02:00\u000barrivalTime;\u00d0%\u00bdj\u0005coordX\u0002\u0018]\u0099\u008e\u00fdGG1@\u0018l\u0091\u00d2\u00ba\u00d6\u00cbH@\fdepartureISO \u00192026-09-30T17:08:00+02:00\rdepartureTime;\u00d0%\u00bdj\bdistance8\u0000\tgeomIndex8\u0000\u0002id:D\u00fc\u00e7\u0004name \u001aOlomouc hlavn\u00c3\u00ad n\u00c3\u00a1dra\u00c5\u00be\u00c3\u00ad\u0007stCodesX\u0000P\n\narrivalISO \u00192026-09-30T17:22:00+02:00\u000barrivalTime;\u0018)\u00bdj\u0005coordX\u0002\u0018\u001f\u00e5}g\u00f6q1@\u0018\u001a\u00b5K/;\u00b9H@\fdepartureISO \u00192026-09-30T17:20:30+02:00\rdepartureTime;\u00be(\u00bdj\bdistance9\u00f0U\